@using BookSaw.Areas.Admin.ViewModels.Book
@model CreateViewModel

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Add Book</h1>
    <p class="mb-4">Fill the form below to add a new book to the catalog.</p>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Add Book</h6>
            <a asp-area="Admin" asp-controller="Book" asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
        </div>
        <div class="card-body">
            <form asp-action="Create" asp-area="Admin" asp-controller="Book" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="ImageUrl">Cover Image URL</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="URL will be saved after upload" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        <small class="form-text text-muted">Accepted: .jpg, .png. (You may also upload files below.)</small>
                    </div>

                    <div class="form-group col-md-8">
                        <label asp-for="Title">Title</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="Author">Author</label>
                        <input asp-for="Author" class="form-control" />
                        <span asp-validation-for="Author" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-3">
                        <label asp-for="Price">Price</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-3">
                        <label asp-for="DiscountRate">Discount Rate (%)</label>
                        <input asp-for="DiscountRate" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="DiscountRate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="ISBN">ISBN</label>
                        <input asp-for="ISBN" class="form-control" />
                        <span asp-validation-for="ISBN" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="Publisher">Publisher</label>
                        <input asp-for="Publisher" class="form-control" />
                        <span asp-validation-for="Publisher" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="Language">Language</label>
                        <input asp-for="Language" class="form-control" />
                        <span asp-validation-for="Language" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label asp-for="Pages">Pages</label>
                        <input asp-for="Pages" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Pages" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-9">
                        <label asp-for="CategoryIds">Categories</label>
                        <select asp-for="CategoryIds" asp-items="ViewBag.Categories" class="form-control" multiple="multiple"></select>
                        <span asp-validation-for="CategoryIds" class="text-danger"></span>
                        <small class="form-text text-muted">Hold Ctrl (Cmd on Mac) to select multiple categories.</small>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Images">Upload Images</label>
                    <input asp-for="Images" class="form-control-file" type="file" multiple />
                    <span asp-validation-for="Images" class="text-danger"></span>
                    <small class="form-text text-muted">You can upload multiple images. Server will save files and populate ImageUrl accordingly.</small>
                </div>

                <div class="form-group">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <select class="form-control"
                            asp-for="CategoryIds"
                            multiple
                            asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                    </select>

                </div>

                <div class="d-flex justify-content-end">
                    <a asp-area="Admin" asp-controller="Book" asp-action="Index" class="btn btn-light mr-2">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

</div>
<!-- /.container-fluid -->
</div>
<!-- End of Main Content -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}